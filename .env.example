# =============================================================================
# Synthetic-Data-Forge — Environment Variables
# Copy to .env and customise for your deployment.
# =============================================================================

# --- Ollama / LLM ---
FORGE_OLLAMA_URL=http://ollama:11434
FORGE_LLM_MODEL=llama3.2:3b
FORGE_LLM_BATCH_SIZE=10
FORGE_LLM_TIMEOUT=300
FORGE_LLM_TEMPERATURE=0.7
FORGE_LLM_MAX_RETRIES=3

# --- Output / Sinks ---
# All local output paths must resolve under this directory.
FORGE_OUTPUT_ROOT=/app/output_data

# --- Safety ---
# Disables credit card, SSN, IBAN generation (recommended for pharma).
FORGE_PHARMA_SAFE_MODE=true

# --- Upload limits ---
FORGE_MAX_UPLOAD_SIZE_MB=200

# --- Privacy Scorecard ---
FORGE_DCR_EXACT_THRESHOLD=0.01
FORGE_DCR_HIGH_RISK_PCT=5.0
FORGE_DCR_HIGH_RISK_MIN=0.005
FORGE_DCR_MEDIUM_RISK_PCT=1.0
FORGE_DCR_MEDIUM_RISK_MIN=0.02
FORGE_DCR_MAX_ROWS=5000

# --- Logging ---
FORGE_LOG_LEVEL=INFO
FORGE_LOG_JSON=false
